# --- Textile FX (server) ---
# Optional. Without a key, requestQuote() uses the keyless taker-proof path (caller must supply a signed TakerControl proof).
TEXTILE_API_KEY=
# Base URL override (default https://api.textilecredit.com/v2)
TEXTILE_API_BASE=https://api.textilecredit.com/v2

# --- buy (usebuy.ai) live paid calls ---
# REQUIRED for live paid calls. If unset, lib/buy.ts throws "live buy calls not configured" — it never fakes a paid call.
# This is the agent wallet private key used to sign x402 (EIP-3009) payments on Celo. NEVER commit a real value.
BUY_WALLET_KEY=
# buy gateway base (default https://gateway.usebuy.ai)
BUY_GATEWAY_BASE=https://gateway.usebuy.ai
# Wallet that receives payments / is declared as PayTo for x402 transactions (Loops requires this for x402 counting)
AGENT_WALLET_ADDRESS=

# --- Celo ---
CELO_RPC_URL=https://forno.celo.org
# ERC-8021 attribution tag issued at Loops registration. Hex string WITHOUT 0x is fine.
# MUST be set before the first live Textile settlement — tags cannot be backfilled.
# Never hardcode a tag in source; if unset, settlement payloads are built WITHOUT a tag and live settle stays gated.
ATTRIBUTION_TAG=

# --- Public (browser-safe) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CELO_EXPLORER=https://celo.blockscout.com
NEXT_PUBLIC_AGENT_ID=
